# WinASR LLM 配置（AI 总结功能）
# 复制此文件为 .env 并填写实际值

# OpenAI 兼容 API 地址（不含 /chat/completions 后缀）
WINASR_LLM_API_BASE=https://api.xiaomimimo.com/v1

# API Key
WINASR_LLM_API_KEY=your_api_key_here

# 模型名称
WINASR_LLM_MODEL=mimo-v2.5

# 模型最大上下文长度（tokens），超过此长度将分段处理
# 常见值：128000 (GPT-4o), 200000 (Claude), 1000000 (Gemini)
WINASR_LLM_MAX_CONTEXT=1000000
